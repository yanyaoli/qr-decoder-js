{
  "name": "qr-decoder-js",
  "version": "1.0.8",
  "description": "Dependency-free TypeScript QR code decoder for browsers",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/types.d.ts",
  "files": [
    "dist",
    "README.md",
    "README_ZH.md",
    "LICENSE.jsQR",
    "LICENSE.qcore"
  ],
  "exports": {
    ".": {
      "types": "./dist/esm/types.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:demo": "pnpm run build && node scripts/build-demo.mjs",
    "test": "node scripts/build.mjs && node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "qrcode",
    "decode",
    "qr",
    "encoding",
    "character-encoding",
    "text-decoding"
  ],
  "author": "yanyaoli",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yanyaoli/qr-decoder-js.git"
  },
  "bugs": {
    "url": "https://github.com/yanyaoli/qr-decoder-js/issues"
  },
  "homepage": "https://github.com/yanyaoli/qr-decoder-js#readme",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.24.0",
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
